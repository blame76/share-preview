Options -Indexes
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hidden files/directories, internal code, tests, secrets and backups are never public.
    RewriteRule (^|/)\. - [F,L,NC]
    RewriteRule ^(?:inc|tests)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)(?:secret|secrets|credentials?)(?:[._/-]|$) - [F,L,NC]
    RewriteRule (?:~|\.(?:md|log|sql|bak|old|tmp|pem|key|swp|dist|ini|ya?ml|orig|save)(?:~)?)$ - [F,L,NC]

    # index.php and selfcheck.php are the only public PHP entry points.
    RewriteRule ^(?!index\.php$|selfcheck\.php$).*\.php$ - [F,L,NC]
</IfModule>

<FilesMatch "(?i)^(?!index\.php$|selfcheck\.php$).+\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)(?:^\.|(?:~|\.(?:md|log|sql|bak|old|tmp|pem|key|swp|dist|ini|ya?ml|orig|save)(?:~)?)$)">
    Require all denied
</FilesMatch>

LimitRequestBody 16384

<IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'none'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
</IfModule>
